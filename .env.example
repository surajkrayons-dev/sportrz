# Sportrz MySQL database.
# These are the database name and user from the supplied hosting database.
# IMPORTANT: replace the password placeholder with the real MySQL password.
# On cPanel, localhost refers to the hosting server. On your Windows PC, localhost
# refers to your own PC's MySQL server, not the live hosting database.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=astrotri_sportrz
MYSQL_USER=astrotri_sportrz_user
MYSQL_PASSWORD=PUT_YOUR_REAL_MYSQL_PASSWORD_HERE
MYSQL_SSL=false

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP email delivery for password-free email OTP. Use cPanel's outgoing server settings.
SMTP_HOST=backend.sportrz.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@backend.sportrz.com
SMTP_PASS=put-your-mailbox-password-here
EMAIL_FROM="Sportrz <no-reply@backend.sportrz.com>"

# Optional Google sign-in (without Firebase).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional key-encryption secret. Keep stable between deployments and back it up securely.
SETTINGS_ENCRYPTION_KEY=

# Razorpay defaults (keep secrets server-only). Admin can override keys in the secure admin settings panel after migration.
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
# Optional fallback for the public /api/webhooks/razorpay endpoint. Prefer setting it encrypted in Admin → Settings & Razorpay.
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional Cloudinary uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
